{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["react", "node"]
  },
  "include": [
    "index.client.tsx",
    "index.server.ts",
    "client/**/*.tsx",
    "client/**/*.ts",
    "server/**/*.ts",
    "shared/**/*.ts"
  ]
}
